{
  "name": "chronoshard",
  "version": "1.0.0",
  "private": true,
  "description": "Chronoshard: Thirteen Chimes, a time-travel pixel RPG",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tests && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "sprites": "node scripts/build-sprites.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource/jersey-20": "^5.3.0",
    "three": "^0.187.0"
  }
}
